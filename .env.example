# Frontend (Vite) — prefixo VITE_ obrigatório
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-publica-anon"

# Script de migração storage (NÃO use chave anon)
# Obter em: Supabase Dashboard → Settings → API → service_role key
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"

# Scripts de backup/restore e provisionamento. Nunca use no frontend.
# SUPABASE_DB_URL e opcional para operacoes administrativas futuras.
SUPABASE_DB_URL="postgresql://usuario:senha@host:5432/postgres"
